# Management server addresses reachable from the learning server.
# For testing everything on this Linux PC, replace SET_SERVER_ADDRESS with localhost.
CLEARML_API_HOST=http://localhost:8008
CLEARML_WEB_HOST=http://localhost:8080
CLEARML_FILES_HOST=http://localhost:8081
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=

# Paths ON THE LEARNING SERVER. Update after moving this folder.
AGENT_HOST_DIR=/home/j/projects_mldl/clearml-agent
DATA_HOST_DIR=/home/j/database
DATA_CONTAINER_DIR=/home/j/database

# Use a different worker ID per running Agent. Shared queue distributes tasks.
AGENT_WORKER_ID=training-worker-1
AGENT_QUEUE=default
# cpu, or GPU indices e.g. 0 or 0,1 (requires host NVIDIA setup).
WORKER_GPUS=0,1
TRAINING_IMAGE=clearml-local/torch:2.9.1-py3.12-cu128

# Private GitHub repository access over HTTPS. Paste the PAT here only.
CLEARML_AGENT_GIT_USER=
CLEARML_AGENT_GIT_PASS=
CLEARML_AGENT_GIT_HOST=github.com
